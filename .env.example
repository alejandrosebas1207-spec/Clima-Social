# ==========================================
# Clima Social · Variables de entorno
# Copia este archivo como .env y completa los
# valores reales. NUNCA subas .env al repositorio.
# ==========================================

# Puerto del servidor
PORT=3000

# ID público del asset (formulario) en KoboToolbox
ASSET_ID=

# Token de API de KoboToolbox
API_TOKEN=

# Nombre del proyecto que se muestra en el encabezado
NOMBRE_PROYECTO=Encuesta Artes y Cultura

# Metas (se usan para el avance)
META_TRABAJADORES=2100
META_GRADUADOS=400

# Fecha límite de la campaña (formato ISO: AAAA-MM-DD)
FECHA_CIERRE=2026-09-19

# Valor de consentimiento afirmativo en Kobo
VALOR_CONSENTIMIENTO_SI=1

# Tiempo de caché del proxy de Kobo (segundos). Reduce llamadas a la API.
CACHE_TTL_SEGUNDOS=90
